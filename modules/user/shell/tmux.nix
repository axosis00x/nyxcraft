# tmux plugins from Nix instead of TPM: installed with the system, nothing
# to fetch with prefix + I. config/tmux/tmux.conf (live-linked) sets their
# options and then loads ~/.local/share/nyxcraft/tmux-plugins.conf, which
# runs each one in this order.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  # omerxx's catppuccin fork (the options in tmux.conf are its own, not the
  # upstream v2 ones), taught to take its colors from the active nyxcraft
  # theme (tmux-palette.sh) instead of a per-flavour file.
  catppuccin = pkgs.tmuxPlugins.mkTmuxPlugin {
    pluginName = "catppuccin";
    version = "0-unstable-e30336b";
    src = pkgs.fetchFromGitHub {
      owner = "omerxx";
      repo = "catppuccin-tmux";
      rev = "e30336b79986e87b1f99e6bd9ec83cffd1da2017";
      hash = "sha256-Ig6+pB8us6YSMHwSRU3sLr9sK+L7kbx2kgxzgmpR920=";
    };
    postPatch = ''
      substituteInPlace catppuccin.tmux \
        --replace-fail 'done < "''${PLUGIN_DIR}/catppuccin-''${theme}.tmuxtheme"' 'done < <(nyxcraft_palette "$theme")'
      sed -i '/^main() {/i source ${./tmux-palette.sh}' catppuccin.tmux
    '';
  };

  corePlugins = with pkgs.tmuxPlugins; [
    sensible
    catppuccin
  ];

  backgroundPlugins = with pkgs.tmuxPlugins; [
    yank
    continuum
    tmux-thumbs
    tmux-fzf
    fzf-tmux-url
    tmux-sessionx
    tmux-floax
  ];
in
{
  config = lib.mkIf config.userSettings.shell.enable {
    xdg.dataFile."nyxcraft/tmux-plugins.conf".text = ''
      # Generated by modules/user/shell/tmux.nix; loaded at the end of tmux.conf.
    ''
    + lib.concatMapStrings (plugin: "run-shell ${plugin.rtp}\n") corePlugins
    + lib.concatMapStrings (plugin: "run-shell -b ${plugin.rtp}\n") backgroundPlugins;
  };
}
